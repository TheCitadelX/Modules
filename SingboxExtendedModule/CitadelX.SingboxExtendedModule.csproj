<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CitadelX.Backend.Abstractions\CitadelX.Backend.Abstractions.csproj" />
  </ItemGroup>

  <!-- Deliver this module as a plugin: drop only its own DLL into the shared modules folder.
       Shared contract assemblies are resolved from the host context, so they are not copied (D2/D3). -->
  <Target Name="CopyToDropFolder" AfterTargets="Build">
    <PropertyGroup>
      <DropFolder>$(MSBuildThisFileDirectory)..\..\Drop\modules</DropFolder>
    </PropertyGroup>
    <MakeDir Directories="$(DropFolder)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DropFolder)" SkipUnchangedFiles="false" />
  </Target>
</Project>
