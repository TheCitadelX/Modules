<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CitadelX.SingboxExtendedNodeModule</AssemblyName>
    <RootNamespace>CitadelX.SingboxExtendedNodeModule</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CitadelX.Node.Abstractions\CitadelX.Node.Abstractions.csproj" />
    <PackageReference Include="Google.Protobuf" Version="3.35.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.81.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos\v2ray-stats.proto" GrpcServices="Client" />
  </ItemGroup>

  <!-- Deliver this node module as a plugin: drop only its own DLL into the shared modules folder.
       Shared contract assemblies are resolved from the host context, so they are not copied (D3). -->
  <Target Name="CopyToDropFolder" AfterTargets="Build">
    <PropertyGroup>
      <DropFolder>$(MSBuildThisFileDirectory)..\..\Drop\modules</DropFolder>
    </PropertyGroup>
    <MakeDir Directories="$(DropFolder)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DropFolder)" SkipUnchangedFiles="false" />
  </Target>
</Project>
